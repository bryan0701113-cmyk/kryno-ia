# === KRYNO IA - Variáveis de Ambiente (Vercel) ===

# Groq API (gratuita - https://console.groq.com/keys)
GROQ_API_KEY=sua-chave-groq-aqui
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Neon Postgres (gratuito - https://neon.tech)
# Crie uma conta, crie um projeto, copie a connection string
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Google OAuth (opcional - login com Google)
GOOGLE_CLIENT_ID=seu-client-id
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_CALLBACK_URL=https://seu-app.vercel.app/auth/google/callback

# Admin
ADMIN_PASS=Kryno2026
ADMIN_PIN=1212

# JWT
JWT_SECRET=kryno2026secreto

# App
NODE_ENV=production

